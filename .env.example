# Aplicação
APP_URL=http://localhost:3000
NODE_ENV=development
DEMO_MODE=true

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://crm_tupiniquim:crm_tupiniquim@localhost:5432/crm_tupiniquim?schema=public

# Autenticação (gerar valor local; nunca versionar o segredo real)
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_RATE_LIMIT_MAX=10
SEED_ADMIN_PASSWORD=
PRIVACY_CONTACT_EMAIL=
DEPLOYMENT_VERSION=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Infraestrutura opcional das fases posteriores
REDIS_URL=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=

# IA assistiva (segredo real apenas em .env.local)
AI_PROVIDER=openai
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# Operação e backup (produção)
BACKUP_DIR=F:\\CODEX\\CRM TUPINIQUIM\\.backups
BACKUP_RETENTION_DAYS=14
PG_BIN_DIR=
