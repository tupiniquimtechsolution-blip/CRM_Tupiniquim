  relevantRisk         Boolean                  @default(false)
  detectedAt           DateTime                 @default(now())
  containedAt          DateTime?
  resolvedAt           DateTime?
  notificationDueAt    DateTime?
  anpdNotifiedAt       DateTime?
  subjectsNotifiedAt   DateTime?
