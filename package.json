{
  "name": "crm-tupiniquim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node scripts/run-seed.mjs scripts/check-tenant-isolation.ts",
    "test:e2e": "playwright test",
    "test:load": "node scripts/run-seed.mjs scripts/ops/load-smoke.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node scripts/run-seed.mjs prisma/seed.ts",
    "db:local": "prisma dev --name crm-tupiniquim --detach",
    "db:local:list": "prisma dev ls",
    "ops:backup": "node scripts/run-seed.mjs scripts/ops/logical-backup.ts",
    "ops:restore-drill": "node scripts/run-seed.mjs scripts/ops/restore-drill.ts",
    "ops:production-check": "node scripts/run-seed.mjs scripts/ops/production-check.ts",
    "ops:index-check": "node scripts/run-seed.mjs scripts/ops/check-indexes.ts",
    "ops:migration-dry-run": "node scripts/run-seed.mjs scripts/ops/final-data-migration.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "openai": "7.4.0",
    "papaparse": "^5.5.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "tailwind-merge": "^3.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "npm": "^12.0.2",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.16.0"
}
